# latexmk configuration for XeLaTeX + natbib/bibtex

# Use XeLaTeX as the LaTeX engine
$pdflatex = 'xelatex -interaction=nonstopmode -file-line-error -synctex=1 %O %S';

# Use bibtex for natbib (not biber for biblatex)
$bibtex = 'bibtex %O %S';

# Enable usage of bibtex
$bibtex_use = 1;

# Maximum runs of xelatex to resolve references
$max_repeat = 5;

# Quiet/silent where possible but keep important errors
$silent = 1;
$warnings_as_errors = 0;

# Clean up extra intermediate files on -c or -C
@generated_exts = (@generated_exts, 'bbl', 'blg');
